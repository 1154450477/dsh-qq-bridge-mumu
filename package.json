{
  "name": "dsh-qq-bridge-mumu",
  "version": "0.5.2",
  "description": "通到 QQ：DSH 里的 AI 伙伴和 QQ 双向互通 —— 它说完话自动发到 QQ，你在 QQ 里说的话自动转进 DSH。走 OneBot 11 HTTP（SnowLuma / NapCat 都行）。附带 MuMu 手机 MCP server（mumu-mcp/）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "tools",
    "mumu-mcp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "author": "Yuuyuko-uu (https://github.com/Yuuyuko-uu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1154450477/dsh-qq-bridge-mumu.git"
  },
  "homepage": "https://github.com/1154450477/dsh-qq-bridge-mumu#readme",
  "bugs": {
    "url": "https://github.com/1154450477/dsh-qq-bridge-mumu/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mumu",
    "mcp"
  ]
}
