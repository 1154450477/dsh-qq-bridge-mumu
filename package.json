{
  "name": "dsh-qq-bridge",
  "version": "0.1.2",
  "description": "通到 QQ：大肥鱼在 DSH 里说完话，自动发到 QQ（先做 DSH→QQ 这半，走 NapCat OneBot HTTP，不经过 Estrella）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}